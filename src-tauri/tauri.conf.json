{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dev-toolbox",
  "version": "0.3.0",
  "identifier": "com.sanduilie-cristian.dev-toolbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "dev-toolbox",
        "fullscreen": false,
        "maximized": true,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDMzA1NDcwNjYwNzM2QjkKUldTNU5nZG1jRlF3SEhzSW5tbjZwZUJ2VHhpUmIwd3Y3TnZNMmtHMVVrWGdwSWhuOGNubmVJclQK",
      "endpoints": [
        "https://github.com/CristiSandu/dev-toolbox/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
