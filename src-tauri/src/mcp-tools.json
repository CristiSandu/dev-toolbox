  {
    "name": "save_test_case",
    "description": "Create or update a case. For creation omit id and use expectedRevision=0. For updates read current content and revision first. Replace the complete document; preserve IDs to track edits. Supports Markdown, lists, products, ordering, duplicate/copy, and restoring a revision snapshot.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "projectId": {
          "type": "integer"
        },
        "expectedRevision": {
          "type": "integer"
        },
        "content": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "title": {
              "type": "string"
            },
            "descriptionMarkdown": {
              "type": "string"
            },
            "lists": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "products": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "title": {
                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        },
                        "imageUrl": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "type": {
                          "enum": [
                            "QR Code",
                            "EAN-13",
                            "DataMatrix",
                            "Code128"
                          ]
                        }
                      },
                      "required": [
                        "id",
                        "title",
                        "text",
                        "type",
                        "imageUrl",
                        "description"
                      ]
                    }
                  }
                },
                "required": [
                  "id",
                  "name",
                  "products"
                ]
              }
            }
          },
          "required": [
            "schemaVersion",
            "title",
            "descriptionMarkdown",
            "lists"
          ]
        }
      },
      "required": [
        "projectId",
        "expectedRevision",
        "content"
      ]
    }
  },
