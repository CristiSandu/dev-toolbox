                    },
                    "required": [
                      "schemaVersion",
                      "title",
                      "descriptionMarkdown",
                      "lists"
                    ]
                  }
                }
              },
              "required": [
                "name",
                "cases"
              ]
            },
            "testCase": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "schemaVersion": {
                  "const": 1
                },
                "title": {
                  "type": "string"
                },
                "descriptionMarkdown": {
                  "type": "string"
                },
                "lists": {
                  "type": "array",
                  "minItems": 1,
