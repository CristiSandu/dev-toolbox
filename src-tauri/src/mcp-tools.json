  {
    "name": "save_test_case_pdf",
    "description": "Save a client-generated PDF to a local file. bytes is an array of PDF bytes; this does not render a case.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "filePath": {
          "type": "string"
