  {
    "name": "generate_barcode",
    "description": "Generate a product barcode as a data URL. DataMatrix supports SVG only.",
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "qr",
